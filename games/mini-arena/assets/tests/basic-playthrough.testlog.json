{
  "game": "mini-arena",
  "scene": "assets/scenes/main.ron",
  "actions": [
    { "cmd": "step", "frames": 5 },
    { "cmd": "press_key", "key": "S" },
    { "cmd": "press_key", "key": "D" },
    {
      "cmd": "wait_until",
      "query": { "tool": "get_transform", "args": { "name": "Player" } },
      "path": "z",
      "op": ">=",
      "value": 2.4,
      "max_frames": 6000,
      "label": "Player walked diagonally (S+D) into Enemy engagement range at z>=2.4"
    },
    { "cmd": "release_key", "key": "S" },
    { "cmd": "release_key", "key": "D" },
    {
      "cmd": "assert",
      "query": { "tool": "get_transform", "args": { "name": "Player" } },
      "path": "x",
      "op": "<",
      "value": 2.55,
      "label": "Player stopped inside the Pickup's x-band (Pickup sits at x=2.0 with a 0.6 radius, so anything past x=2.6 can never collect it — this catches an overshoot here rather than as an unexplained timeout 8000 frames later)"
    },
    { "cmd": "step", "frames": 2 },
    { "cmd": "press_key", "key": "Space" },
    { "cmd": "release_key", "key": "Space" },
    { "cmd": "step", "frames": 5 },
    { "cmd": "press_key", "key": "Space" },
    { "cmd": "release_key", "key": "Space" },
    { "cmd": "step", "frames": 5 },
    {
      "cmd": "assert",
      "query": { "tool": "get_transform", "args": { "name": "Enemy" } },
      "path": "x",
      "op": "==",
      "value": null,
      "label": "Enemy destroyed after two raycast melee hits (30 max shield, 15 dmg each)"
    },
    {
      "cmd": "assert",
      "query": { "tool": "get_transform", "args": { "name": "Pickup" } },
      "path": "x",
      "op": "exists",
      "value": null,
      "label": "Pickup exists before the walk (guards the wait below from passing vacuously)"
    },
    { "cmd": "press_key", "key": "W" },
    {
      "cmd": "wait_until",
      "query": { "tool": "get_transform", "args": { "name": "Pickup" } },
      "path": "x",
      "op": "==",
      "value": null,
      "max_frames": 8000,
      "label": "Player walked north far enough to collect the Pickup (proximity trigger destroys it)"
    },
    { "cmd": "release_key", "key": "W" },
    { "cmd": "step", "frames": 2 },
    {
      "cmd": "assert",
      "query": { "tool": "get_transform", "args": { "name": "Player" } },
      "path": "z",
      "op": "<",
      "value": -1.0,
      "label": "Player ended north of the origin, having walked from (0,0) through the Enemy engagement at (~2.4, ~2.4) to the Pickup's z-band (stops near z=-1.56, where the 0.6 collection radius is first reached)"
    },
    { "cmd": "shutdown" }
  ]
}
